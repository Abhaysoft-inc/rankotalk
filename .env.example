# Copy to .env (or set in the host's build settings).
# The live domain, used for canonical URLs, the sitemap and robots.txt.
SITE_URL=https://rankotalk.in

# Optional: verification tags from Google Search Console and Bing Webmaster Tools.
# Only the token goes here (the content="..." value), not the whole meta tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=


