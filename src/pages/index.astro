---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { orgLd, websiteLd } from '../lib/schema';

const title = `${SITE.name}: JEE Main College Predictor & Counselling`;
const description =
  'Free tools and plain-language guides for JEE Main students: a college predictor, a percentile to rank calculator and a step-by-step JoSAA counselling guide.';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  // Google's fallback advice: the lowercase hostname as the last alternate name.
  websiteLd(Astro.site!.href, [Astro.site!.host]),
  orgLd(Astro.site!.href, new URL('/icon-512.png', Astro.site).href),
];
---

<Base {title} {description} {jsonLd}>
  <div class="container">
    <div class="page-head">
      <h1>Find the right college after JEE Main</h1>
      <p class="lead">
        {SITE.name} helps JEE Main students turn a rank into a shortlist of NITs, IIITs and GFTIs, and understand
        JoSAA counselling without the confusion. Everything is free, and you never need to log in.
      </p>
      <p style="margin-top:1.25rem">
        <a class="btn" href="/jee-main-college-predictor">Open the college predictor</a>
      </p>
    </div>

    <section class="section" aria-labelledby="tools">
      <h2 id="tools" style="font-size:1.625rem;font-weight:600;line-height:1.25">Tools</h2>
      <div class="card-list">
        <article class="card">
          <h3><a href="/jee-main-college-predictor">JEE Main College Predictor</a></h3>
          <p>Enter your rank, category, gender and home state to see Safe, Moderate and Reach options at NITs, IIITs and GFTIs.</p>
        </article>
        <article class="card">
          <h3><a href="/jee-advanced-college-predictor">JEE Advanced (IIT) Predictor</a></h3>
          <p>Find out which of the 23 IITs and engineering branches you can target with your JEE Advanced All India Rank.</p>
        </article>
        <article class="card">
          <h3><a href="/jee-main-percentile-vs-rank">Percentile vs Rank Calculator</a></h3>
          <p>Convert your NTA percentile into an expected rank before the result, or a rank into a percentile.</p>
        </article>
        <article class="card">
          <h3><a href="/college-admissions-calculator">College Admissions Calculator</a></h3>
          <p>Applying to US colleges? Compare your SAT or ACT and GPA with each college and see your Reach, Target and Likely schools.</p>
        </article>
        <article class="card">
          <h3><a href="/mbbs-abroad">MBBS Abroad Tools</a></h3>
          <p>Check your eligibility, test universities against NMC rules, and work out the real cost before you pay a fee.</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="guides">
      <h2 id="guides" style="font-size:1.625rem;font-weight:600;line-height:1.25">Counselling guides</h2>
      <div class="card-list">
        {guides.map((g) => (
          <article class="card">
            <h3><a href={`/guides/${g.id}`}>{g.data.title}</a></h3>
            <p>{g.data.description}</p>
          </article>
        ))}
      </div>
      <p style="margin-top:1rem"><a href="/guides">See all guides</a></p>
    </section>

    <section class="section article prose" aria-labelledby="why">
      <h2 id="why" style="margin-top:0">Why students use {SITE.name}</h2>
      <ul>
        <li><strong>No login, no email.</strong> Open the page, enter your rank and get your list.</li>
        <li><strong>Plain language.</strong> Guides explain freeze, float, slide, quotas and rounds without jargon.</li>
        <li><strong>Built for phones.</strong> Most students check on a phone, so every page is designed to read well on a small screen.</li>
        <li><strong>Honest about limits.</strong> We tell you what a prediction can and cannot do, and we send you to the official websites for dates and rules.</li>
      </ul>
    </section>
  </div>
</Base>
