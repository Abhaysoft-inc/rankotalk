---
import Base from '../layouts/Base.astro';

const title = 'Page not found | RankOtalk';
const description = 'The page you are looking for does not exist.';
---

<Base {title} {description} noindex>
  <div class="container">
    <div class="page-head">
      <h1>Page not found</h1>
      <p class="lead">We could not find that page. You may want one of these instead.</p>
    </div>
    <div class="article prose">
      <ul>
        <li><a href="/jee-main-college-predictor">JEE Main college predictor</a></li>
        <li><a href="/jee-main-percentile-vs-rank">Percentile vs rank calculator</a></li>
        <li><a href="/guides">Counselling guides</a></li>
        <li><a href="/">Home</a></li>
      </ul>
    </div>
  </div>
</Base>
