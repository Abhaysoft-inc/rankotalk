---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config';

const title = `JoSAA Counselling Guides | ${SITE.name}`;
const description = 'Plain-language guides to JoSAA counselling: the process, choice filling, Home State quota and the documents you need.';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<Base {title} {description}>
  <div class="container">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides' }]} />
    <div class="page-head">
      <h1>JoSAA counselling guides</h1>
      <p class="lead">Short, clear explanations of how counselling works and how to make good choices.</p>
    </div>
    <div class="card-list">
      {guides.map((g) => (
        <article class="card">
          <h2 style="font-size:1.125rem;font-weight:600;line-height:1.3;margin:0"><a href={`/guides/${g.id}`}>{g.data.title}</a></h2>
          <p>{g.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</Base>
