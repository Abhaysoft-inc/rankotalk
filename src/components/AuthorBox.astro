---
import { SITE, OFFICIAL } from '../config';

interface Props {
  updated: string;
}
const { updated } = Astro.props;
const label = new Date(updated + 'T00:00:00Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<aside class="author-box">
  <p><strong>Written by the {SITE.name} editorial team.</strong></p>
  <p>
    Dates, rules and process steps are checked against the official
    <a href={OFFICIAL.josaa} rel="noopener" target="_blank">JoSAA</a>,
    <a href={OFFICIAL.jeeMain} rel="noopener" target="_blank">JEE Main</a> and
    <a href={OFFICIAL.csab} rel="noopener" target="_blank">CSAB</a> websites.
    Last updated <time datetime={updated}>{label}</time>.
  </p>
</aside>
