---
// Answers are plain text so the visible text always matches the FAQPage schema.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <div class="answer"><p>{item.a}</p></div>
    </details>
  ))}
</div>
